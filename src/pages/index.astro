---
import { site } from '~/config';
import Layout from '~/layouts/page.astro';
---

<style>
	.hero {
		margin-block-start: 30vh;
		text-align: center;
	}
</style>

<Layout title={false}>
	<section class="hero">
		<h1>{ site.name }</h1>
		<p>{ site.summary }</p>
		<a href="/books">Browse Books &rarr;</a>
	</section>
</Layout>
