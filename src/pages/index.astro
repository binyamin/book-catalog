---
import IconRightArrow from 'microns/svg/arrow-right.svg';
import { site } from '~/config';
import Layout from '~/layouts/page.astro';
---

<style>
	.hero {
		margin-block-start: 30vh;
		text-align: center;
	}
</style>

<Layout title="">
	<section class="hero">
		<h1>{site.name}</h1>
		<p>{site.summary}</p>
		<a href="/books">Browse Books <IconRightArrow class="icon" /></a>
	</section>
</Layout>
