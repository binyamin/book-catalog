---
import { site } from '~/config';
import '~/css/main.css';

export interface Props {
	title: string;
	ignore?: boolean;
}

const title = [Astro.props.title || [], site.name].flat().join(' | ');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="text-scale" content="scale" />
		<link rel="icon" href="data:," />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{Astro.props.ignore && <meta name="robots" content="noindex" />}
	</head>
	<body>
		<slot />
	</body>
</html>
