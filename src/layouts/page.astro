---
import { site } from '~/config';
import Layout, { type Props as LayoutProps } from './base.astro';

import './page.css';

export interface Props extends LayoutProps {
	class?: string;
}
---

<Layout {...Astro.props}>
	<div class="app | l-cover">
		<header>
			<a href="/" class="_logo" aria-label="homepage">{ site.name }</a>
		</header>
		<main class:list={["l-cover_target", Astro.props.class]}>
			<slot />
		</main>
		<footer class="l-center">
			<p>
				Made by <a href="https://binyam.in">Binyamin Green</a>
			</p>
		</footer>
	</div>
</Layout>
